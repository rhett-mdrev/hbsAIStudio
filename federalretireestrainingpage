<style>
  :root{
    --ink:#16323C;
    --ink-soft:#4A6570;
    --paper:#F2F4F3;
    --card:#FFFFFF;
    --rule:#D3DBD9;
    --auto:#1F6F5C;
    --auto-bg:#E4F0EC;
    --person:#7A3E7E;
    --person-bg:#F1E7F2;
    --note:#1D3C7A;
    --note-bg:#E6EBF5;
    --serif:"Newsreader",Georgia,"Times New Roman",serif;
    --sans:"Source Sans 3",-apple-system,BlinkMacSystemFont,"Segoe UI",Helvetica,Arial,sans-serif;
  }

  *{box-sizing:border-box}
  html{-webkit-text-size-adjust:100%}
  body{
    margin:0;
    background:var(--paper);
    color:var(--ink);
    font-family:var(--sans);
    font-size:17px;
    line-height:1.6;
  }
  .wrap{max-width:960px;margin:0 auto;padding:0 24px}

  a{color:var(--note)}
  a:focus-visible,summary:focus-visible{outline:3px solid var(--note);outline-offset:3px}

  /* ---------- Masthead ---------- */
  .masthead{
    background:var(--ink);
    color:#EAF0F0;
    padding:56px 0 44px;
    border-bottom:6px solid var(--auto);
  }
  .kicker{
    font-size:15px;
    letter-spacing:.02em;
    color:#9FB6BC;
    margin:0 0 14px;
  }
  .masthead h1{
    font-family:var(--serif);
    font-weight:600;
    font-size:clamp(34px,5.4vw,52px);
    line-height:1.1;
    margin:0 0 18px;
    letter-spacing:-.01em;
  }
  .masthead p{
    max-width:62ch;
    margin:0;
    font-size:19px;
    color:#CBD9DC;
  }
  .stamp{
    display:inline-block;
    margin-top:26px;
    padding:7px 14px;
    border:1px solid #3D5C67;
    border-radius:3px;
    font-size:14px;
    color:#9FB6BC;
  }

  /* ---------- Sections ---------- */
  section{padding:52px 0}
  section + section{border-top:1px solid var(--rule)}
  h2{
    font-family:var(--serif);
    font-weight:600;
    font-size:29px;
    line-height:1.25;
    margin:0 0 10px;
  }
  h2 + .lede{margin:0 0 30px;max-width:66ch;color:var(--ink-soft)}
  h3{font-size:19px;margin:34px 0 10px}
  p{max-width:70ch}

  /* ---------- Legend ---------- */
  .legend{display:grid;gap:16px;grid-template-columns:1fr 1fr;margin-top:26px}
  .legend div{
    background:var(--card);
    border-left:5px solid;
    padding:18px 20px;
    border-radius:2px;
  }
  .legend .l-auto{border-color:var(--auto)}
  .legend .l-person{border-color:var(--person)}
  .legend strong{display:block;font-size:17px;margin-bottom:4px}
  .legend p{margin:0;font-size:16px;color:var(--ink-soft)}

  .chip{
    display:inline-block;
    padding:4px 11px;
    border-radius:100px;
    font-size:13.5px;
    font-weight:600;
    white-space:nowrap;
  }
  .chip-auto{background:var(--auto-bg);color:var(--auto)}
  .chip-person{background:var(--person-bg);color:var(--person)}

  /* ---------- Existing systems ---------- */
  .keeps{list-style:none;padding:0;margin:24px 0 0;max-width:72ch}
  .keeps li{
    padding:14px 0 14px 30px;
    border-top:1px solid var(--rule);
    position:relative;
  }
  .keeps li:last-child{border-bottom:1px solid var(--rule)}
  .keeps li::before{
    content:"";
    position:absolute;
    left:2px;top:22px;
    width:11px;height:11px;
    background:var(--auto);
    border-radius:2px;
  }
  .keeps b{font-weight:600}

  /* ---------- Stages ---------- */
  .stage{
    display:grid;
    grid-template-columns:118px 1fr;
    gap:28px;
    background:var(--card);
    border-radius:2px;
    padding:26px 28px;
    margin-bottom:14px;
    border-left:5px solid var(--rule);
  }
  .stage.is-auto{border-left-color:var(--auto)}
  .stage.is-person{border-left-color:var(--person)}
  .rail .num{
    font-family:var(--serif);
    font-size:40px;
    line-height:1;
    color:var(--ink);
    display:block;
    margin-bottom:12px;
  }
  .stage h3{
    margin:0 0 10px;
    font-size:21px;
    font-weight:700;
    line-height:1.3;
  }
  .stage p{margin:0 0 12px;max-width:64ch}
  .stage p:last-child{margin-bottom:0}
  .does{list-style:none;padding:0;margin:0 0 14px;max-width:64ch}
  .does li{
    padding:3px 0 3px 20px;
    position:relative;
    font-size:16.5px;
    color:var(--ink-soft);
  }
  .does li::before{
    content:"";
    position:absolute;left:2px;top:14px;
    width:7px;height:1px;background:var(--ink-soft);
  }
  .sms{
    border:1px solid var(--rule);
    border-left:3px solid var(--ink-soft);
    background:#FAFBFB;
    padding:14px 16px;
    margin:0 0 14px;
    max-width:62ch;
    border-radius:2px;
  }
  .sms span{
    display:block;
    font-size:13.5px;
    color:var(--ink-soft);
    margin-bottom:6px;
  }
  .sms q{
    font-family:var(--serif);
    font-size:17.5px;
    line-height:1.55;
    quotes:"“" "”";
  }
  .tagline{font-size:15.5px;color:var(--ink-soft);margin:0}
  code{
    font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
    font-size:14.5px;
    background:var(--paper);
    padding:2px 6px;
    border-radius:3px;
  }

  /* ---------- Tables ---------- */
  .tablewrap{overflow-x:auto;margin-top:20px}
  table{border-collapse:collapse;width:100%;min-width:520px;background:var(--card)}
  th,td{text-align:left;padding:12px 16px;border-bottom:1px solid var(--rule);font-size:16px;vertical-align:top}
  th{font-weight:700;background:#E9EDEC;font-size:15px}
  td code{background:var(--paper)}

  /* ---------- Notes ---------- */
  .note{
    background:var(--note-bg);
    border-left:5px solid var(--note);
    padding:22px 24px;
    border-radius:2px;
    margin-top:24px;
  }
  .note h3{margin:0 0 8px;color:var(--note);font-size:19px}
  .note p{margin:0 0 10px}
  .note p:last-child{margin-bottom:0}

  .decisions{counter-reset:d;list-style:none;padding:0;margin:24px 0 0}
  .decisions li{
    counter-increment:d;
    background:var(--card);
    padding:18px 22px 18px 62px;
    position:relative;
    margin-bottom:10px;
    border-radius:2px;
    max-width:74ch;
  }
  .decisions li::before{
    content:counter(d);
    position:absolute;left:22px;top:17px;
    font-family:var(--serif);
    font-size:22px;
    color:var(--person);
  }
  .decisions b{display:block;margin-bottom:3px}
  .decisions span{color:var(--ink-soft);font-size:16px}

  footer{
    background:var(--ink);
    color:#9FB6BC;
    padding:34px 0;
    font-size:15px;
    margin-top:20px;
  }
  footer p{margin:0;max-width:70ch}

  @media (max-width:720px){
    body{font-size:16px}
    .legend{grid-template-columns:1fr}
    .stage{grid-template-columns:1fr;gap:14px;padding:22px}
    .rail{display:flex;align-items:center;gap:14px}
    .rail .num{font-size:30px;margin:0}
    section{padding:40px 0}
  }
  @media print{
    body{background:#fff}
    .masthead,footer{background:#fff;color:#000;border-color:#000}
    .masthead p,.kicker{color:#333}
    .stage{break-inside:avoid;border:1px solid #ccc;border-left-width:5px}
  }
  @media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
