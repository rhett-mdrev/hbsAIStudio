<script>
  const deck   = document.getElementById('deck');
  const slides = Array.from(document.querySelectorAll('.slide'));
  const bar    = document.getElementById('bar');
  const cnow   = document.getElementById('cnow');
  const dotsEl = document.getElementById('dots');
  const pad    = n => String(n).padStart(2,'0');
  document.getElementById('ctot').textContent = pad(slides.length);

  // build nav dots
  slides.forEach((s,i)=>{
    const b=document.createElement('button');
    b.setAttribute('aria-label','Go to slide '+(i+1));
    b.addEventListener('click',()=>s.scrollIntoView({behavior:'smooth'}));
    dotsEl.appendChild(b);
  });
  const dotBtns = Array.from(dotsEl.children);

  // active slide + reveal via IntersectionObserver
  const io = new IntersectionObserver((entries)=>{
    entries.forEach(e=>{
      if(e.isIntersecting && e.intersectionRatio>=0.55){
        const i = slides.indexOf(e.target);
        e.target.classList.add('active');
        cnow.textContent = pad(i+1);
        dotBtns.forEach((d,k)=>d.classList.toggle('on',k===i));
        // adapt counter colour to slide theme
        document.querySelector('.counter').style.color =
          e.target.classList.contains('slide--dark') ? 'rgba(252,246,245,.9)' : '';
      }
    });
  },{root:deck,threshold:[0.55]});
  slides.forEach(s=>io.observe(s));

  // progress bar
  deck.addEventListener('scroll',()=>{
    const max = deck.scrollHeight - deck.clientHeight;
    bar.style.width = (max>0 ? (deck.scrollTop/max*100) : 0) + '%';
  },{passive:true});

  // keyboard navigation
  const go = dir => {
    const cur = slides.findIndex(s=>s.classList.contains('active'));
    const next = Math.min(slides.length-1, Math.max(0, (cur<0?0:cur)+dir));
    slides[next].scrollIntoView({behavior:'smooth'});
  };
  deck.focus();
  window.addEventListener('keydown',e=>{
    if(['ArrowDown','PageDown',' '].includes(e.key)){e.preventDefault();go(1);}
    else if(['ArrowUp','PageUp'].includes(e.key)){e.preventDefault();go(-1);}
    else if(e.key==='Home'){e.preventDefault();slides[0].scrollIntoView({behavior:'smooth'});}
    else if(e.key==='End'){e.preventDefault();slides[slides.length-1].scrollIntoView({behavior:'smooth'});}
  });

  // activate first slide immediately
  slides[0].classList.add('active');
</script>
